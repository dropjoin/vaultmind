# VaultMind environment — copy to .env and fill in. NEVER commit .env.

# Otari hosted platform API key (starts with otk_). Create one in the
# Otari.ai dashboard: workspace -> API Keys -> Generate.
# One shared key works; per-role virtual keys (see config/otari-routing.yml)
# can override it via the OTARI_KEY_<ROLE> variables below.
OTARI_API_KEY=

# Optional per-role virtual keys (scoped + revocable in the Otari dashboard).
# If unset, the role falls back to OTARI_API_KEY.
OTARI_KEY_PROPOSER=
OTARI_KEY_CHECKER=
OTARI_KEY_REPORTER=

# Otari gateway base URL. Verified live 2026-11-04: the hosted API lives
# under /api/v1 (the older blog example used /v1 and now returns 404 with a
# correction message — see NOTES.md). EU accounts: https://eu.api.otari.ai/api/v1
OTARI_BASE_URL=https://api.otari.ai/api/v1

# Arbitrum Sepolia RPC endpoints (comma separated, tried in order).
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc,https://arbitrum-sepolia-rpc.publicnode.com,https://arbitrum-sepolia.gateway.tenderly.co

# AgentVault contract (Arbitrum Sepolia).
VAULTMIND_VAULT_ADDRESS=0x0344c57616d0ff50608D85B1852C5e3E3C87d1C3
